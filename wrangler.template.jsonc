/**
 * Wrangler template — committed to git, never edited manually.
 * Run `npm run wrangler:generate` (or any script that calls it) to produce wrangler.jsonc.
 *
 * Fields marked "generated" are overwritten by scripts/generate-wrangler.ts from
 * config.yaml (deploy.*) and the CLOUDFLARE_ACCOUNT_ID env var. Do not put real
 * values here — they will be silently overwritten on the next generation.
 *
 * For more details on Wrangler configuration:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "", // generated: deploy.name
	"main": "src/index.ts",
	"compatibility_date": "2025-06-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [{ "pattern": "", "custom_domain": true }], // generated: deploy.domain (omitted when domain is unset)
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1 // log 100% of invocations; lower only if nearing the Free Logs limit
	},
	"vars": {
		"CLOUDFLARE_ACCOUNT_ID": "", // generated: $CLOUDFLARE_ACCOUNT_ID env var
		"D1_DATABASE_ID": "", // generated: deploy.database_id
		"QUEUE_ID": "", // generated: notifications queue id (used for Account Analytics filtering)
		"WORKER_NAME": "", // generated: deploy.name (used for usage GraphQL scriptName + UI display)
		"APP_VERSION": "", // generated: package.json version (shown in status page footer)
		"SITE_TITLE": "", // generated: site.title from config.yaml (status page header + tab; empty = "HeartbeatFlare")
		"PROBE_HEADERS": "{}", // generated: JSON map of monitor id → custom HTTP probe headers (${VAR} placeholders preserved)
		"LOG_LEVEL": "info" // runtime log level: info (default) | debug; debug adds successful checks + probe timings
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "", // generated: deploy.database_name (default: <name>-prod-db)
			"database_id": "", // generated: deploy.database_id
			"migrations_dir": "migrations"
		}
	],
	"queues": {
		"producers": [{ "queue": "", "binding": "NOTIFICATION_QUEUE" }], // generated: deploy.queue_name
		"consumers": [{ "queue": "", "max_batch_size": 10, "max_batch_timeout": 5, "max_retries": 8 }] // notifications only; 8 retries × backoff (src/queue.ts) ≈ ~14 min budget
	},
	"send_email": [], // generated from type: email notification channels; omitted when none are configured
	// Rate limiters for public endpoints, checked before any D1 access. Best-effort per-colo limiting.
	// namespace_id is account-global — bindings sharing an id (even on other Workers) share counters — so
	// each namespace_id below is generated per deployment from deploy.name + the binding name; the "100x"
	// values are placeholders overwritten by scripts/generate-wrangler.ts (Issue #63).
	"ratelimits": [
		// POST /beat/<id>/<token> or /beat/<id> (heartbeat ingest).
		{ "name": "BEAT_IP_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }, // generated: namespace_id
		{ "name": "BEAT_MONITOR_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }, // generated: namespace_id
		// Defence-in-depth for the read/status endpoints (/public, /api/*, /badge*, /feed.xml, /badges):
		// the edge cache is the primary control, but it's a no-op on *.workers.dev, and any cache-bypass
		// falls back to this per-IP budget before touching D1. Authenticated (Access) requests are exempt.
		{ "name": "READ_IP_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } } // generated: namespace_id
	]
}
